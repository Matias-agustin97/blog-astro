---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();

// Agrupa los posts por año
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout title="Blog" description="Todos los posts del blog, ordenados por fecha.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <h1>Todos los <span class="gradient-text">posts</span></h1>
      <p>{posts.length} artículos sobre desarrollo, diseño y aprendizaje.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--narrow">
      {
        [...byYear.entries()].map(([year, yearPosts]) => (
          <div class="year-group">
            <h2 class="year-group__title">{year}</h2>
            <div class="post-list">
              {yearPosts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
