---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTagCounts, tagSlug, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTagCounts(posts).map(([tag]) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts sobre ${tag}.`}>
  <section class="page-hero">
    <div class="container">
      <a href="/tags" class="link-arrow">← Todas las etiquetas</a>
      <h1><span class="gradient-text">#{tag}</span></h1>
      <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} con esta etiqueta.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--narrow post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
